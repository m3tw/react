{
  "name": "react-md3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "api:contract:sync": "node ./scripts/sync-api-contract.mjs",
    "api:contract:check": "node ./scripts/check-api-contract.mjs",
    "traceability:check": "node ./scripts/check-prd-epics-traceability.mjs",
    "traceability:report": "node ./scripts/check-prd-epics-traceability.mjs --report ../release-evidence/traceability-report.md",
    "m3:coverage:check": "node ./scripts/check-m3-coverage.mjs",
    "m3:coverage:report": "node ./scripts/check-m3-coverage.mjs --report ./docs/m3-coverage-baseline.md",
    "quality:gate": "npm run lint && npm run test && npm run build && npm run api:contract:check && npm run m3:coverage:check",
    "quality:gate:full": "npm run quality:gate && npm run traceability:check",
    "test:watch": "vitest",
    "preview": "vite preview",
    "hooks:install": "sh ./scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.1.4",
    "vitest": "^4.0.18"
  }
}
